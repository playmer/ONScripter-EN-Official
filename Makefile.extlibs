##-- ogg -----------------------------------------------------------------------
libogg_input_files = $(shell find "$(EXTERNAL_SOURCE)/$(OGG_VER)" -type f )
libogg_target = $(addprefix $(EXTERNAL_INSTALL_PREFIX)/, include/ogg/config_types.h include/ogg/ogg.h include/ogg/os_types.h lib/libogg.a lib/libogg.la lib/pkgconfig/ogg.pc share/aclocal/ogg.m4)
$(libogg_target): $(libogg_input_files)
	@echo "Building $(OGG_VER)"
	rm -rf $(EXTERNAL_INTERMEDIATE_PREFIX)/$(OGG_VER)
	mkdir -p $(EXTERNAL_INTERMEDIATE_PREFIX)
	mkdir -p $(EXTERNAL_INSTALL_PREFIX)
	cp -r $(EXTERNAL_SOURCE)/$(OGG_VER) $(EXTERNAL_INTERMEDIATE_PREFIX)
	cd $(EXTERNAL_INTERMEDIATE_PREFIX)/$(OGG_VER) && \
	autoreconf -ivf && \
	./configure --prefix="$(EXTERNAL_INSTALL_PREFIX)" --disable-shared --disable-dependency-trackin && \
	$(MAKE) -j  && \
	$(MAKE) install
	
