# -*- makefile-gmake -*-
# Build rules for internal libraries.
# Do not invoke this directly; these rules are used automatically when relevant.

ifndef VERBOSE # use "make VERBOSE=true" to show outputs
REDIR = >/dev/null 2>&1
REDSO = >/dev/null
endif

#EL = extlib/lib
#EI = extlib/include
#EB = extlib/bin
#ES = extlib/src

ROOT_DIR = $(shell pwd)

EXTERNAL_SOURCE = $(ROOT_DIR)/extlib/src

EXTERNAL_PREFIX = $(ROOT_DIR)/build/extlib
EXTERNAL_INSTALL_PREFIX = $(EXTERNAL_PREFIX)/install
EXTERNAL_INTERMEDIATE_PREFIX = $(EXTERNAL_PREFIX)/src

#OUTDIRS += $(EL)
#OUTDIRS += $(EI)
#OUTDIRS += $(EB)
#
#OUTDIRS := $(OUTDIRS)

#PKG_CONFIG_PATH := $(TOPSRC)/$(EL)/pkgconfig:$(PKG_CONFIG_PATH)
#export PKG_CONFIG_PATH

# NOTE: If you update one of these versions, you _MUST_ double check the file
# list (named <libname>_target below) used as output when building them.
SDL_VER      = SDL-1.2.15
SDLIMAGE_VER = SDL_image-1.2.12
ZLIB_VER     = zlib-1.2.13
PNG_VER      = libpng-1.6.39
JPEG_VER     = jpeg-9f
SDLMIXER_VER = SDL_mixer-1.2.12
OGG_VER      = libogg-1.3.5
VORB_VER     = libvorbis-1.3.7
SMPEG_VER    = smpeg
BZIP_VER     = bzip2-1.0.8
FREETYPE_VER = freetype-2.13.0
SDLT_VER     = SDL_ttf-2.0.11

